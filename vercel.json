{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route=$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__route=health"
    },
    {
      "source": "/favicon.svg",
      "destination": "/static/favicon.svg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/static/favicon.svg"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/index.html",
      "destination": "/static/index.html"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ]
}
